# Browser-visible configuration
# URL students scan/open. Do not put secrets in VITE_* variables.
VITE_PUBLIC_APP_URL=https://your-quickprint-domain.example
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only configuration. Never expose these with a VITE_ prefix.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Server-only scheduled maintenance secret.
QUICKPRINT_CRON_SECRET=replace_with_a_long_random_secret
QUICKPRINT_CRON_SECRET_PREVIOUS=
